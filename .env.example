# ============================================
# IrotechLab Auth — Environment Variables
# ============================================
# Copy to .env for local dev, or paste each key
# into Netlify → Site configuration → Environment variables.
# ============================================

# --- Neon Postgres ---
# From: console.neon.tech → project → Connection Details → Connection string
DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- RS256 JWT signing keys ---
# Generate with: node scripts/generate-keys.mjs
# Or openssl (no npm):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Escape newlines as \n (single backslash + n) before pasting.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_KEY_ID=iro-key-1

# --- Session encryption (iron-session) ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=at-least-32-characters-long-random-string

# --- Public issuer URL ---
# Local dev:   http://localhost:3000
# Production:  https://irotechlab-auth.netlify.app
APP_URL=http://localhost:3000

# --- Upstash Redis (rate limiting) ---
# From: console.upstash.com → Redis → REST API
UPSTASH_REDIS_URL=https://xxx.upstash.io
UPSTASH_REDIS_TOKEN=AXxxAAIncxxxxxxxxxxxxxxxxxx

# --- SMTP (Maileroo) — email verification & password reset ---
# Port 465 = implicit SSL/TLS (recommended)
# Port 587 / 2525 = STARTTLS
SMTP_HOST=smtp.maileroo.com
SMTP_PORT=465
SMTP_USER=your_maileroo_smtp_username
SMTP_PASS=your_maileroo_smtp_password
SMTP_FROM=IrotechLab Auth <no-reply@yourdomain.com>
# "true" for 465 (SSL), "false" for 587/2525 (STARTTLS)
SMTP_SECURE=true

# --- irocap CAPTCHA ---
# irocap is self-hosted. Source: https://github.com/IROTECHLAB/irocap
# 1. Fork and deploy irocap to your own Vercel account
# 2. Register your domain at <your-irocap-url>/admin.html
# 3. Copy the sitekey + secret into the vars below
NEXT_PUBLIC_IROCAP_SITEKEY=your_irocap_sitekey
IROCAP_SECRET=your_irocap_secret
# URL of your irocap instance (no trailing slash)
# Example: https://irocap-yourname.vercel.app
NEXT_PUBLIC_IROCAP_BASE=https://your-irocap-instance.vercel.app
IROCAP_BASE=https://your-irocap-instance.vercel.app
